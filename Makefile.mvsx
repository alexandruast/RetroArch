#########################################################################
## RetroArch for the SNK Neo Geo MVSX / Arcade Stick Pro               ##
## (Actions ATM7051, ARMv7 Cortex-A9 + NEON, glibc, SDL 1.2 fbcon)     ##
##                                                                     ##
## Cross-built with the Arm GNU Toolchain (arm-none-linux-gnueabihf).  ##
## The resulting binary expects its own glibc in /mnt/hdisk/retroarch/ ##
## lib (dynamic linker path baked in), as the existing MVSX install.   ##
#########################################################################

# Toolchain / dependency locations (override on the command line)
# Tools live next to this repository, in <workspace>/_tools (see
# pkg/mvsx/DEVELOPMENT-NOTES.md). The native Windows toolchain needs
# C:/ style paths even under MSYS, hence cygpath. Override with MVSX_TOOLS.
MVSX_TOOLS     ?= $(shell cygpath -m "$(abspath $(CURDIR)/../_tools)" 2>/dev/null || echo "$(abspath $(CURDIR)/../_tools)")
TOOLCHAIN_DIR  ?= $(MVSX_TOOLS)/arm-gnu
TOOLCHAIN_PFX  ?= $(TOOLCHAIN_DIR)/bin/arm-none-linux-gnueabihf-
# SDL 1.2 headers (SDL/ subdirectory inside)
SDL12_INC      ?= $(MVSX_TOOLS)/sdl12-include
# Directory holding libSDL-1.2.so.0 (+ libts.so.0) taken from the device
MVSX_STAGE_LIB ?= $(MVSX_TOOLS)/mvsx-stage-lib
# Where the package lives on the device
MVSX_PREFIX    ?= /mnt/hdisk/retroarch

CC             = $(TOOLCHAIN_PFX)gcc
CXX            = $(TOOLCHAIN_PFX)g++
STRIP          = $(TOOLCHAIN_PFX)strip

PACKAGE_NAME = retroarch

DEBUG ?= 0

MVSX = 1
OS = Linux
TARGET = retroarch

HAVE_SDL = 1
HAVE_DYNAMIC = 1
HAVE_DYLIB = 1
HAVE_THREADS = 1
HAVE_C99 = 1
HAVE_CC = 1
HAVE_CXX = 1
HAVE_GETOPT_LONG = 1
HAVE_STRCASESTR = 1
HAVE_MMAP = 1
HAVE_NEON = 1

HAVE_MENU = 1
HAVE_MENU_COMMON = 1
HAVE_RGUI = 1
HAVE_MATERIALUI = 0
HAVE_XMB = 0
HAVE_OZONE = 0
HAVE_GFX_WIDGETS = 0
HAVE_OVERLAY = 0

HAVE_CONFIGFILE = 1
HAVE_LIBRETRODB = 1
HAVE_CORE_INFO_CACHE = 1
HAVE_CHEATS = 1
HAVE_PATCH = 1
HAVE_XDELTA = 0
HAVE_REWIND = 1
HAVE_RUNAHEAD = 1
HAVE_SCREENSHOTS = 1
HAVE_BSV_MOVIE = 1

HAVE_NETWORKING = 1
HAVE_NETPLAYDISCOVERY = 1
HAVE_NETWORK_CMD = 1
HAVE_COMMAND = 1
HAVE_STDIN_CMD = 0
HAVE_GETADDRINFO = 1
HAVE_SSL = 0
HAVE_CHEEVOS = 0
HAVE_TRANSLATE = 0

HAVE_ZLIB = 1
HAVE_BUILTINZLIB = 1
HAVE_7ZIP = 1
HAVE_CHD = 1
HAVE_RPNG = 1
HAVE_RJPEG = 1
HAVE_RBMP = 1
HAVE_RTGA = 1
HAVE_IMAGEVIEWER = 0
HAVE_LANGEXTRA = 1

HAVE_VIDEO_FILTER = 1
HAVE_DSP_FILTER = 1
HAVE_STATIC_VIDEO_FILTERS = 0
HAVE_STATIC_AUDIO_FILTERS = 0
HAVE_CC_RESAMPLER = 1
HAVE_NEAREST_RESAMPLER = 1

HAVE_OSS = 1
HAVE_ALSA = 0
HAVE_TINYALSA = 0
HAVE_AL = 0
HAVE_AUDIOMIXER = 0

HAVE_FREETYPE = 0
HAVE_STB_FONT = 0
HAVE_OPENGL = 0
HAVE_OPENGL1 = 0
HAVE_OPENGLES = 0
HAVE_OPENGLES3 = 0
HAVE_OPENGL_CORE = 0
HAVE_EGL = 0
HAVE_GLSL = 0
HAVE_SHADERPIPELINE = 0
HAVE_X11 = 0
HAVE_UDEV = 0
HAVE_HID = 0
HAVE_LIBUSB = 0
HAVE_ACCESSIBILITY = 0
HAVE_CRTSWITCHRES = 0

OBJ :=
LINK := $(CXX)
# The MVSX SoC (Actions GS702C) is a Cortex-A5 with VFPv4 + NEON
DEF_FLAGS := -mcpu=cortex-a5 -mtune=cortex-a5 -mfpu=neon-vfpv4 -mfloat-abi=hard -marm
DEF_FLAGS += -ffunction-sections -fdata-sections -fno-strict-aliasing
DEF_FLAGS += -I. -Ideps -Ideps/stb -DMVSX=1 -MMD
DEF_FLAGS += -Wall -Wno-unused-variable -Wno-unused-function
DEF_FLAGS += -D_GNU_SOURCE
LIBS := -ldl -lrt -lm -pthread
CFLAGS := -std=gnu99
CXXFLAGS := -fno-exceptions -fno-rtti -std=c++11 -D__STDC_CONSTANT_MACROS
ASFLAGS :=
LDFLAGS := -Wl,--gc-sections -Wl,-z,noexecstack
LDFLAGS += -Wl,--dynamic-linker=$(MVSX_PREFIX)/lib/ld-linux-armhf.so.3
LDFLAGS += -Wl,-rpath,$(MVSX_PREFIX)/lib
LDFLAGS += -Wl,-rpath-link,$(MVSX_STAGE_LIB)
INCLUDE_DIRS =
LIBRARY_DIRS =
DEFINES := -DRARCH_INTERNAL -D_FILE_OFFSET_BITS=64 -UHAVE_STATIC_DUMMY
DEFINES += -DHAVE_C99=1 -DHAVE_CXX=1
DEFINES += -DHAVE_GETOPT_LONG=1 -DHAVE_STRCASESTR=1 -DHAVE_DYNAMIC=1
DEFINES += -DHAVE_OSS=1 -DHAVE_SDL=1
DEFINES += -DCC_RESAMPLER_PRECISION=0

SDL_CFLAGS := -I$(SDL12_INC) -I$(SDL12_INC)/SDL -D_GNU_SOURCE=1 -D_REENTRANT
SDL_LIBS   := $(MVSX_STAGE_LIB)/libSDL-1.2.so.0
MMAP_LIBS = -lc

OBJDIR_BASE := obj-mvsx

ifeq ($(DEBUG), 1)
   OBJDIR := $(OBJDIR_BASE)/debug
   DEF_FLAGS += -O0 -g -DDEBUG -D_DEBUG
else
   OBJDIR := $(OBJDIR_BASE)/release
   DEF_FLAGS += -O2 -DNDEBUG
endif

include Makefile.common

DEF_FLAGS += $(INCLUDE_DIRS)
LDFLAGS += $(CFLAGS) $(CXXFLAGS) $(DEF_FLAGS)
CFLAGS += $(DEF_FLAGS)
CXXFLAGS += $(DEF_FLAGS)

HEADERS = $(wildcard */*/*.h) $(wildcard */*.h) $(wildcard *.h)

ifneq ($(V),1)
        Q := @
endif

RARCH_OBJ := $(addprefix $(OBJDIR)/,$(OBJ))

all: $(TARGET)

define INFO
CC: $(CC)
CFLAGS: $(CFLAGS)
CXX: $(CXX)
CXXFLAGS: $(CXXFLAGS)
DEFINES: $(DEFINES)
LDFLAGS: $(LDFLAGS)
LIBS: $(LIBS)
endef
export INFO

info:
	@echo "$$INFO"

-include $(RARCH_OBJ:.o=.d)

$(TARGET): $(RARCH_OBJ)
	@$(if $(Q), $(shell echo echo LD $@),)
	$(Q)$(LINK) -o $@ $(RARCH_OBJ) $(LIBS) $(LDFLAGS) $(LIBRARY_DIRS)
ifeq ($(STRIP_BIN),1)
	$(STRIP) --strip-unneeded $(TARGET)
endif

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) $(DEFINES) -c -o $@ $<

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo CXX $<),)
	$(Q)$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEFINES) -MMD -c -o $@ $<

$(OBJDIR)/%.o: %.S $(HEADERS)
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo AS $<),)
	$(Q)$(CC) $(CFLAGS) $(ASFLAGS) $(DEFINES) -c -o $@ $<

clean:
	@$(if $(Q), echo $@,)
	$(Q)rm -rf $(OBJDIR_BASE)
	$(Q)rm -f $(TARGET)
	$(Q)rm -f *.d

.PHONY: all clean info

print-%:
	@echo '$*=$($*)'
